# Go Together — Frontend environment
# Copy to .env and fill in real values. Never commit the real .env.

# Backend API base URL (keep /api/v1)
NEXT_PUBLIC_BASE_API_URL=http://localhost:5000/api/v1

# Used to build absolute image URLs on the client
NEXT_PUBLIC_API_URL=http://localhost:5000

# Stripe publishable key (pk_test_... for development)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Google (GCP) OAuth client id — enables the "Continue with Google" button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
